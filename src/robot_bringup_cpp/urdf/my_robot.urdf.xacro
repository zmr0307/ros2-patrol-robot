<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="my_robot">

  <link name="base_footprint" />

<link name="base_link">
    <visual>
      <geometry>
        <box size="0.45 0.38 0.5" />
      </geometry>
      <material name="blue_material">
        <color rgba="0.2 0.2 0.8 0.7" />
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.45 0.38 0.5" />
      </geometry>
    </collision>
    <inertial>
      <mass value="8.0" />
      <inertia ixx="0.08" ixy="0.0" ixz="0.0" iyy="0.12" iyz="0.0" izz="0.15" />
    </inertial>
  </link>

  <link name="left_wheel_link">
    <visual>
      <origin rpy="1.5707 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.051" radius="0.0645"/>
      </geometry>
      <material name="grey_material">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="1.5707 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.051" radius="0.0645"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.5"/>
      <inertia ixx="0.002" ixy="0.0" ixz="0.0" iyy="0.002" iyz="0.0" izz="0.004"/>
    </inertial>
  </link>

  <link name="right_wheel_link">
    <visual>
      <origin rpy="1.5707 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.051" radius="0.0645"/>
      </geometry>
      <material name="grey_material">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="1.5707 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.051" radius="0.0645"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.5"/>
      <inertia ixx="0.002" ixy="0.0" ixz="0.0" iyy="0.002" iyz="0.0" izz="0.004"/>
    </inertial>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.398" rpy="0 0 0"/>  <!-- 2025-11-15更新: 底盘高50cm，中心离地39.8cm（轮心6.45cm + 底盘下沿到中心25cm） -->
  </joint>

  <!-- 新增：中心立柱结构 14.4cm×14.4cm×100cm -->
  <link name="center_pillar_link">
    <visual>
      <geometry>
        <box size="0.144 0.144 1.0" />
      </geometry>
      <material name="pillar_material">
        <color rgba="0.3 0.3 0.3 0.9" />  <!-- 深灰色 -->
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.144 0.144 1.0" />
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0" />
      <inertia ixx="0.42" ixy="0.0" ixz="0.0" iyy="0.42" iyz="0.0" izz="0.01" />
    </inertial>
  </link>

  <joint name="center_pillar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="center_pillar_link"/>
    <origin xyz="0 0 0.25" rpy="0 0 0"/>  <!-- 立柱中心相对base_link向上25cm，使立柱底面与底盘底面重合 -->
  </joint>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin rpy="0 0 0" xyz="0 0.11682 -0.3335"/>  <!-- 2025-11-15更新: 轮距23.364cm/2=11.682cm, 底盘高50cm后轮心相对base_link为-33.35cm -->
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin rpy="0 0 0" xyz="0 -0.11682 -0.3335"/>  <!-- 2025-11-15更新: 轮距23.364cm/2=11.682cm, 底盘高50cm后轮心相对base_link为-33.35cm -->
    <axis xyz="0 1 0"/>
  </joint>

  <link name="laser_link">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
      <material name="red">
        <color rgba="1.0 0.0 0.0 1.0" />
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0.258 0 0.322" rpy="0 0 0"/>  <!-- 2025-12-07更新: 雷达底部离地70cm，雷达中心离地72cm，相对base_link(39.8cm)为32.2cm --> 
  </joint>

</robot>