<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="my_robot">

  <link name="base_footprint" />

<link name="base_link">
    <visual>
      <geometry>
        <box size="0.45 0.38 0.15" />
      </geometry>
      <material name="blue_material">
        <color rgba="0.2 0.2 0.8 0.7" />
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.45 0.38 0.15" />
      </geometry>
    </collision>
    <inertial>
      <mass value="8.0" />
      <inertia ixx="0.08" ixy="0.0" ixz="0.0" iyy="0.12" iyz="0.0" izz="0.15" />
    </inertial>
  </link>

  <link name="left_wheel_link">
    <visual>
      <origin rpy="1.5707 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.051" radius="0.0645"/>
      </geometry>
      <material name="grey_material">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="1.5707 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.051" radius="0.0645"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.5"/>
      <inertia ixx="0.002" ixy="0.0" ixz="0.0" iyy="0.002" iyz="0.0" izz="0.004"/>
    </inertial>
  </link>

  <link name="right_wheel_link">
    <visual>
      <origin rpy="1.5707 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.051" radius="0.0645"/>
      </geometry>
      <material name="grey_material">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="1.5707 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.051" radius="0.0645"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.5"/>
      <inertia ixx="0.002" ixy="0.0" ixz="0.0" iyy="0.002" iyz="0.0" izz="0.004"/>
    </inertial>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.2225" rpy="0 0 0"/>  <!-- 修正: 0.2225 + (-0.158) = 0.0645 (轮半径-标定值0.0645m) -->
  </joint>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin rpy="0 0 0" xyz="0 0.11682 -0.158"/>  <!-- 轮距23.364cm/2=11.682cm（线性插值：2圈少转10.5°，3圈多转6.1°）, 轮心离地6.4cm -->
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin rpy="0 0 0" xyz="0 -0.11682 -0.158"/>  <!-- 轮距23.364cm/2=11.682cm（线性插值：2圈少转10.5°，3圈多转6.1°）, 轮心离地6.4cm -->
    <axis xyz="0 1 0"/>
  </joint>

  <link name="laser_link">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
      <material name="red">
        <color rgba="1.0 0.0 0.0 1.0" />
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0.157 0 0.214" rpy="0 0 0"/>  <!-- 修正+0.002: 思岚S2L精确实测 --> 
  </joint>

</robot>